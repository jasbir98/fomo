# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraper — Python venv + Playwright browser profiles. Not gitignored before,
# which let Tailwind v4's automatic content scanner (which skips gitignored
# paths) walk into scraper/.pw-profile/**/SingletonSocket — a literal Unix
# domain socket, not a regular file — and crash Turbopack's CSS asset graph
# with "Operation not supported on socket" on every route. Ignoring these
# paths keeps them out of the scan without touching any of the scraper's
# live files.
/scraper/.venv/
/scraper/.pw-profile/

# scraper run output — regenerable pipeline results, not app source.
# scraper/data (inputs + progress files), scraper/countries and
# scraper/happenings (Python packages) stay tracked.
/scraper/out/
/scraper/consolidated/
__pycache__/
*.pyc
# Raw scrape backups (third-party handles/captions) and the progress-file
# lock used by parallel batch runs — local only.
/scraper/data/scraped_*.jsonl
/scraper/data/*.lock

# VS Code unsaved-buffer artifacts (the ":" breaks Windows checkouts)
untitled:*
